              <span class="font-medium">Suco Garrafa Tamarindo 1L</span>
              <div class="flex items-center gap-3">
                <span class="font-bold">R$ 12,00</span>
                <button class="w-8 h-8 orange-gradient text-white rounded-full orange-hover" onclick="adicionarAoCarrinho('Suco Garrafa Tamarindo 1L',12.00)">
                  <i class="fas fa-plus text-xs"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Café -->
  <section id="cafe" class="py-10 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center mb-6">
        <span class="text-2xl mr-3">☕</span>
        <h3 class="text-2xl font-bold">Vamos de Café?</h3>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="menu-item p-4 card-hover">
          <div class="flex justify-between items-center">
            <span class="font-medium">Café 150ml</span>
            <div class="flex items-center gap-3">
              <span class="font-bold">R$ 2,00</span>
              <button class="w-8 h-8 orange-gradient text-white rounded-full orange-hover" onclick="adicionarAoCarrinho('Café 150ml',2.00)">
                <i class="fas fa-plus text-xs"></i>
              </button>
            </div>
          </div>
        </div>
        <div class="menu-item p-4 card-hover">
          <div class="flex justify-between items-center">
            <span class="font-medium">Café 200ml</span>
            <div class="flex items-center gap-3">
              <span class="font-bold">R$ 3,00</span>
              <button class="w-8 h-8 orange-gradient text-white rounded-full orange-hover" onclick="adicionarAoCarrinho('Café 200ml',3.00)">
                <i class="fas fa-plus text-xs"></i>
              </button>
            </div>
          </div>
        </div>
        <div class="menu-item p-4 card-hover">
          <div class="flex justify-between items-center">
            <span class="font-medium">Café 250ml</span>
            <div class="flex items-center gap-3">
              <span class="font-bold">R$ 4,00</span>
              <button class="w-8 h-8 orange-gradient text-white rounded-full orange-hover" onclick="adicionarAoCarrinho('Café 250ml',4.00)">
                <i class="fas fa-plus text-xs"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Botão Voltar ao Topo -->
  <div id="scroll-to-top" class="scroll-to-top" onclick="voltarAoTopo()">
    <i class="fas fa-arrow-up text-lg"></i>
  </div>

  <!-- Carrinho Modal -->
  <div id="carrinho-overlay" class="carrinho-overlay" onclick="fecharCarrinho()"></div>
  <div id="carrinho-modal" class="carrinho-modal">
    <div class="p-6 border-b border-gray-200">
      <div class="flex items-center justify-between">
        <h3 class="text-xl font-bold">Meu Carrinho</h3>
        <button onclick="fecharCarrinho()" class="text-gray-500 hover:text-gray-700">
          <i class="fas fa-times text-xl"></i>
        </button>
      </div>
    </div>
    
    <div class="flex-1 overflow-y-auto p-6">
      <div id="carrinho-items" class="space-y-4">
        <!-- Items do carrinho serão inseridos aqui -->
      </div>
      
      <div id="carrinho-vazio" class="text-center py-12 text-gray-500">
        <i class="fas fa-shopping-cart text-4xl mb-4"></i>
        <p>Seu carrinho está vazio</p>
        <p class="text-sm">Adicione alguns itens deliciosos!</p>
      </div>
    </div>
    
    <div id="carrinho-footer" class="p-6 border-t border-gray-200 bg-gray-50" style="display: none;">
      <div class="flex justify-between items-center mb-4">
        <span class="text-lg font-semibold">Total:</span>
        <span id="carrinho-total" class="text-xl font-bold text-orange-600">R$ 0,00</span>
      </div>
      <button onclick="finalizarPedido()" class="w-full orange-gradient text-white py-3 rounded-lg font-semibold orange-hover">
        <i class="fab fa-whatsapp mr-2"></i>
        Enviar Pedido pelo WhatsApp
      </button>
    </div>
  </div>

  <script>
    let carrinho = [];
    let carrinhoAberto = false;

    function adicionarAoCarrinho(nome, preco) {
      const item = {
        id: Date.now() + Math.random(),
        nome: nome,
        preco: parseFloat(preco),
        quantidade: 1
      };
      
      const itemExistente = carrinho.find(i => i.nome === nome);
      if (itemExistente) {
        itemExistente.quantidade++;
      } else {
        carrinho.push(item);
      }
      
      atualizarCarrinho();
      mostrarNotificacao(`${nome} adicionado ao carrinho!`);
    }

    function removerDoCarrinho(id) {
      carrinho = carrinho.filter(item => item.id != id);
      atualizarCarrinho();
    }

    function alterarQuantidade(id, novaQuantidade) {
      if (novaQuantidade <= 0) {
        removerDoCarrinho(id);
        return;
      }
      
      const item = carrinho.find(i => i.id == id);
      if (item) {
        item.quantidade = parseInt(novaQuantidade);
        atualizarCarrinho();
      }
    }

    function atualizarCarrinho() {
      const carrinhoItems = document.getElementById('carrinho-items');
      const carrinhoVazio = document.getElementById('carrinho-vazio');
      const carrinhoFooter = document.getElementById('carrinho-footer');
      const cartCounter = document.getElementById('cart-counter');
      const carrinhoTotal = document.getElementById('carrinho-total');
      
      if (carrinho.length === 0) {
        carrinhoItems.innerHTML = '';
        carrinhoVazio.style.display = 'block';
        carrinhoFooter.style.display = 'none';
        cartCounter.style.display = 'none';
        return;
      }
      
      carrinhoVazio.style.display = 'none';
      carrinhoFooter.style.display = 'block';
      
      let totalItens = 0;
      let totalPreco = 0;
      
      carrinhoItems.innerHTML = carrinho.map(item => {
        totalItens += item.quantidade;
        totalPreco += item.preco * item.quantidade;
        
        return `
          <div class="flex items-center justify-between bg-white p-4 rounded-lg border">
            <div class="flex-1">
              <h4 class="font-medium text-sm">${item.nome}</h4>
              <p class="text-orange-600 font-semibold">R$ ${item.preco.toFixed(2)}</p>
            </div>
            <div class="flex items-center gap-2">
              <button onclick="alterarQuantidade('${item.id}', ${item.quantidade - 1})" class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center hover:bg-gray-300">
                <i class="fas fa-minus text-xs"></i>
              </button>
              <span class="w-8 text-center font-semibold">${item.quantidade}</span>
              <button onclick="alterarQuantidade('${item.id}', ${item.quantidade + 1})" class="w-8 h-8 bg-orange-500 text-white rounded-full flex items-center justify-center hover:bg-orange-600">
                <i class="fas fa-plus text-xs"></i>
              </button>
              <button onclick="removerDoCarrinho('${item.id}')" class="w-8 h-8 bg-red-500 text-white rounded-full flex items-center justify-center hover:bg-red-600 ml-2">
                <i class="fas fa-trash text-xs"></i>
              </button>
            </div>
          </div>
        `;
      }).join('');
      
      cartCounter.textContent = totalItens;
      cartCounter.style.display = totalItens > 0 ? 'flex' : 'none';
      carrinhoTotal.textContent = `R$ ${totalPreco.toFixed(2)}`;
    }

    function abrirCarrinho() {
      document.getElementById('carrinho-overlay').style.display = 'block';
      document.getElementById('carrinho-modal').classList.add('open');
      carrinhoAberto = true;
    }

    function fecharCarrinho() {
      document.getElementById('carrinho-overlay').style.display = 'none';
      document.getElementById('carrinho-modal').classList.remove('open');
      carrinhoAberto = false;
    }

    function finalizarPedido() {
      if (carrinho.length === 0) return;
      
      // Fechar carrinho primeiro
      fecharCarrinho();
      
      // Mostrar checkout automaticamente
      mostrarCheckout();
    }

    function mostrarCheckout() {
      const overlay = document.createElement('div');
      overlay.className = 'fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4';
      // Remover clique fora para fechar
      overlay.onclick = function(e) {
        e.stopPropagation();
      };
      
      let totalPedido = 0;
      carrinho.forEach(item => {
        totalPedido += item.preco * item.quantidade;
      });
      
      overlay.innerHTML = `
        <div class="bg-white rounded-xl w-full max-w-md max-h-[90vh] overflow-hidden flex flex-col" onclick="event.stopPropagation()">
          <!-- Header Fixo -->
          <div class="p-4 border-b border-gray-200 text-center flex-shrink-0 bg-white sticky top-0 z-10">
            <h3 class="text-lg font-bold">Finalizar Pedido</h3>
            <p class="text-xs text-gray-600 mt-1">Deslize para navegar • Preencha os dados</p>
          </div>
          
          <!-- Conteúdo Scrollável com Scroll Suave -->
          <div class="flex-1 overflow-y-auto p-4 scroll-smooth" style="min-height: 0; scroll-behavior: smooth;">
            <!-- Resumo Compacto -->
            <div class="bg-orange-50 p-3 rounded-lg mb-4 border border-orange-200 sticky top-0 z-5 shadow-sm">
              <h4 class="font-semibold text-orange-800 mb-2 text-sm">📋 Resumo do Pedido</h4>
              <div class="max-h-24 overflow-y-auto space-y-1">
                ${carrinho.map(item => `
                  <div class="flex justify-between text-xs">
                    <span>${item.quantidade}x ${item.nome}</span>
                    <span class="font-semibold">R$ ${(item.preco * item.quantidade).toFixed(2)}</span>
                  </div>
                `).join('')}
              </div>
              <div class="border-t border-orange-300 mt-2 pt-2 flex justify-between font-bold text-orange-800 text-sm">
                <span>Total:</span>
                <span>R$ ${totalPedido.toFixed(2)}</span>
              </div>
            </div>
            <!-- Formulário -->
            <form id="checkout-form" class="space-y-4">
              <!-- Dados Pessoais -->
              <div class="space-y-3">
                <h4 class="font-semibold text-gray-800 border-b pb-2 text-sm">👤 Dados Pessoais</h4>
                
                <div>
                  <label class="block text-sm font-medium mb-1">Nome Completo *</label>
                  <input type="text" id="checkout-nome" required class="w-full p-3 text-sm border border-gray-300 rounded-lg focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-200">
                </div>
                
                <div>
                  <label class="block text-sm font-medium mb-1">Telefone *</label>
                  <input type="tel" id="checkout-telefone" required placeholder="(85) 99999-9999" class="w-full p-3 text-sm border border-gray-300 rounded-lg focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-200">
                </div>
              </div>
              
              <!-- Entrega -->
              <div class="space-y-3">
                <h4 class="font-semibold text-gray-800 border-b pb-2 text-sm">🚚 Tipo de Entrega</h4>
                
                <div class="space-y-2">
                  <label class="flex items-center gap-3 p-3 border border-gray-300 rounded-lg cursor-pointer hover:border-orange-300 hover:bg-orange-50 transition-colors">
                    <input type="radio" name="checkout-entrega" value="retirada" class="text-orange-500" onchange="toggleCheckoutEndereco()">
                    <span class="text-sm">🏪 Retirada no Local</span>
                  </label>
                  
                  <label class="flex items-center gap-3 p-3 border border-gray-300 rounded-lg cursor-pointer hover:border-orange-300 hover:bg-orange-50 transition-colors">
                    <input type="radio" name="checkout-entrega" value="delivery" class="text-orange-500" onchange="toggleCheckoutEndereco()">
                    <span class="text-sm">🛵 Delivery</span>
                  </label>
                </div>
                
                <div id="checkout-endereco-section" style="display: none;" class="bg-blue-50 p-3 rounded-lg border border-blue-200">
                  <label class="block text-sm font-medium mb-2">📍 Endereço Completo *</label>
                  <textarea id="checkout-endereco" rows="3" placeholder="Rua, número, bairro..." class="w-full p-3 text-sm border border-gray-300 rounded-lg focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-200 resize-none"></textarea>
                </div>
              </div>
              
              <!-- Pagamento -->
              <div class="space-y-3">
                <h4 class="font-semibold text-gray-800 border-b pb-2 text-sm">💳 Forma de Pagamento</h4>
                
                <div class="space-y-2">
                  <label class="flex items-center gap-3 p-3 border border-gray-300 rounded-lg cursor-pointer hover:border-orange-300 hover:bg-orange-50 transition-colors">
                    <input type="radio" name="checkout-pagamento" value="dinheiro" class="text-orange-500" onchange="toggleCheckoutPixInfo()">
                    <span class="text-sm">💵 Dinheiro</span>
                  </label>
                  
                  <label class="flex items-center gap-3 p-3 border border-gray-300 rounded-lg cursor-pointer hover:border-orange-300 hover:bg-orange-50 transition-colors">
                    <input type="radio" name="checkout-pagamento" value="cartao" class="text-orange-500" onchange="toggleCheckoutPixInfo()">
                    <span class="text-sm">💳 Cartão</span>
                  </label>
                  
                  <label class="flex items-center gap-3 p-3 border border-gray-300 rounded-lg cursor-pointer hover:border-orange-300 hover:bg-orange-50 transition-colors">
                    <input type="radio" name="checkout-pagamento" value="pix" class="text-orange-500" onchange="toggleCheckoutPixInfo()">
                    <span class="text-sm">📱 PIX</span>
                  </label>
                </div>
                
                <div id="checkout-pix-info" style="display: none;" class="bg-orange-50 p-3 rounded-lg border border-orange-200">
                  <h5 class="font-semibold text-orange-800 mb-2 text-sm">📱 Chave do PIX</h5>
                  <div class="text-sm space-y-2">
                    <div class="flex items-center justify-between bg-white p-3 rounded-lg border">
                      <div>
                        <p><strong>Celular:</strong> 85 989901099</p>
                        <p><strong>Banco:</strong> PagSeguro</p>
                        <p>(Keila Lourenço da Silva)</p>
                      </div>
                      <button type="button" onclick="copiarChavePix()" class="bg-orange-500 text-white px-3 py-2 rounded-lg text-sm hover:bg-orange-600 transition-colors">
                        Copiar
                      </button>
                    </div>
                  </div>
                </div>
              </div>
              
              <!-- Observações -->
              <div class="space-y-3">
                <h4 class="font-semibold text-gray-800 border-b pb-2 text-sm">📝 Observações</h4>
                <textarea id="checkout-observacoes" rows="3" placeholder="Observações opcionais..." class="w-full p-3 text-sm border border-gray-300 rounded-lg focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-200 resize-none"></textarea>
              </div>
            </form>
          </div>
          
          <!-- Footer com Botões -->
          <div class="p-4 border-t border-gray-200 bg-gray-50 flex-shrink-0 sticky bottom-0">
            <div class="flex gap-3">
              <button type="button" onclick="fecharCheckout()" class="flex-1 bg-gray-300 text-gray-700 py-3 rounded-lg font-semibold hover:bg-gray-400 text-sm transition-colors">
                Voltar
              </button>
              <button type="submit" form="checkout-form" class="flex-1 orange-gradient text-white py-3 rounded-lg font-semibold orange-hover text-sm transition-colors">
                <i class="fab fa-whatsapp mr-2"></i>
                Finalizar
              </button>
            </div>
          </div>
        </div>
      `;
      
      document.body.appendChild(overlay);
      
      // Event listener para o formulário
      document.getElementById('checkout-form').addEventListener('submit', function(e) {
        e.preventDefault();
        processarCheckout();
      });
      
      // Focar no primeiro campo
      document.getElementById('checkout-nome').focus();
    }

    function toggleCheckoutEndereco() {
      const entrega = document.querySelector('input[name="checkout-entrega"]:checked');
      if (!entrega) return;
      
      const enderecoSection = document.getElementById('checkout-endereco-section');
      const enderecoInput = document.getElementById('checkout-endereco');
      
      if (entrega.value === 'delivery') {
        enderecoSection.style.display = 'block';
        enderecoInput.required = true;
      } else {
        enderecoSection.style.display = 'none';
        enderecoInput.required = false;
        enderecoInput.value = '';
      }
    }

    function toggleCheckoutPixInfo() {
      const pagamento = document.querySelector('input[name="checkout-pagamento"]:checked');
      if (!pagamento) return;
      
      const pixInfo = document.getElementById('checkout-pix-info');
      
      if (pagamento.value === 'pix') {
        pixInfo.style.display = 'block';
      } else {
        pixInfo.style.display = 'none';
      }
    }

    function fecharCheckout() {
      const overlay = document.querySelector('.fixed.inset-0.bg-black.bg-opacity-50');
      if (overlay) {
        document.body.removeChild(overlay);
      }
    }

    function processarCheckout() {
      // Validar campos obrigatórios
      const nome = document.getElementById('checkout-nome').value.trim();
      const telefone = document.getElementById('checkout-telefone').value.trim();
      const entrega = document.querySelector('input[name="checkout-entrega"]:checked');
      const pagamento = document.querySelector('input[name="checkout-pagamento"]:checked');
      
      if (!nome || !telefone || !entrega || !pagamento) {
        alert('Por favor, preencha todos os campos obrigatórios!');
        return;
      }
      
      if (entrega.value === 'delivery') {
        const endereco = document.getElementById('checkout-endereco').value.trim();
        if (!endereco) {
          alert('Por favor, informe o endereço para entrega!');
          return;
        }
      }
      
      // Montar mensagem
      let mensagem = "🍽️ *PEDIDO - SABOR CASEIRO LANCHES*\n\n";
      
      // Dados do cliente
      mensagem += "👤 *DADOS DO CLIENTE:*\n";
      mensagem += `• Nome: ${nome}\n`;
      mensagem += `• Telefone: ${telefone}\n\n`;
      
      // Itens do pedido
      mensagem += "🛒 *ITENS DO PEDIDO:*\n";
      let total = 0;
      
      carrinho.forEach(item => {
        const subtotal = item.preco * item.quantidade;
        total += subtotal;
        mensagem += `• ${item.quantidade}x ${item.nome}\n`;
        mensagem += `  R$ ${item.preco.toFixed(2)} cada = R$ ${subtotal.toFixed(2)}\n\n`;
      });
      
      mensagem += `💰 *TOTAL: R$ ${total.toFixed(2)}*\n\n`;
      
      // Tipo de entrega
      mensagem += "🚚 *ENTREGA:*\n";
      if (entrega.value === 'retirada') {
        mensagem += "🏪 Retirada no Local\n\n";
      } else {
        const endereco = document.getElementById('checkout-endereco').value.trim();
        mensagem += "🛵 Delivery\n";
        mensagem += `📍 Endereço: ${endereco}\n`;
        mensagem += "⚠️ Taxa de entrega será informada\n\n";
      }
      
      // Forma de pagamento
      mensagem += "💳 *PAGAMENTO:*\n";
      const formaPagamento = {
        'dinheiro': '💵 Dinheiro',
        'cartao': '💳 Cartão de Crédito ou Débito (Presencial)',
        'pix': '📱 PIX'
      };
      mensagem += formaPagamento[pagamento.value] + "\n";
      
      if (pagamento.value === 'pix') {
        mensagem += "\n📱 *CHAVE DO PIX:*\n";
        mensagem += "• Celular: 85 989901099\n";
        mensagem += "• Banco: PagSeguro\n";
        mensagem += "• (Keila Lourenço da Silva)\n";
      }
      
      // Observações
      const observacoes = document.getElementById('checkout-observacoes').value.trim();
      if (observacoes) {
        mensagem += `\n📝 *OBSERVAÇÕES:*\n${observacoes}\n`;
      }
      
      mensagem += "\n✨ Obrigado pela preferência! 😊";
      
      // Enviar para WhatsApp
      const numeroWhatsApp = "5585981489840";
      const url = `https://wa.me/${numeroWhatsApp}?text=${encodeURIComponent(mensagem)}`;
      
      window.open(url, '_blank');
      
      // Fechar checkout e carrinho
      fecharCheckout();
      fecharCarrinho();
      
      // Limpar carrinho
      carrinho = [];
      atualizarCarrinho();
      
      mostrarNotificacao('Pedido enviado com sucesso! 🎉');
    }



    function copiarChavePix() {
      const chavePix = "85989901099";
      
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(chavePix).then(() => {
          mostrarNotificacao('Chave PIX copiada! 📋');
        }).catch(() => {
          // Fallback se clipboard API falhar
          copiarTextoFallback(chavePix);
        });
      } else {
        // Fallback para navegadores mais antigos
        copiarTextoFallback(chavePix);
      }
    }

    function copiarTextoFallback(texto) {
      const textArea = document.createElement('textarea');
      textArea.value = texto;
      textArea.style.position = 'fixed';
      textArea.style.left = '-999999px';
      textArea.style.top = '-999999px';
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      
      try {
        document.execCommand('copy');
        mostrarNotificacao('Chave PIX copiada! 📋');
      } catch (err) {
        mostrarNotificacao('Erro ao copiar. Chave: 85989901099');
      }
      
      document.body.removeChild(textArea);
    }

    function mostrarInformacoes() {
      const overlay = document.createElement('div');
      overlay.className = 'fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4';
      overlay.onclick = function(e) {
        if (e.target === overlay) {
          document.body.removeChild(overlay);
        }
      };
      
      overlay.innerHTML = `
        <div class="bg-white rounded-xl w-full max-w-lg max-h-[90vh] overflow-hidden flex flex-col" onclick="event.stopPropagation()">
          <!-- Header -->
          <div class="p-4 border-b border-gray-200 text-center flex-shrink-0 bg-orange-50">
            <div class="flex items-center justify-between">
              <h3 class="text-lg font-bold text-orange-800">ℹ️ Informações</h3>
              <button onclick="fecharInformacoes()" class="text-gray-500 hover:text-gray-700">
                <i class="fas fa-times text-xl"></i>
              </button>
            </div>
            <p class="text-sm text-orange-600 mt-1">SABOR CASEIRO LANCHES</p>
          </div>
          
          <!-- Conteúdo Scrollável -->
          <div class="flex-1 overflow-y-auto p-4 scroll-smooth">
            
            <!-- Endereço -->
            <div class="mb-6">
              <h4 class="font-semibold text-gray-800 mb-3 flex items-center gap-2">
                <i class="fas fa-map-marker-alt text-orange-500"></i>
                Endereço
              </h4>
              <p class="text-sm text-gray-600 bg-gray-50 p-3 rounded-lg">
                Av. Marginal Nordeste, 304 - Jereissati III<br>
                Pacatuba - CE, 61800-000, Brasil
              </p>
            </div>

            <!-- Tipos de Serviço -->
            <div class="mb-6">
              <h4 class="font-semibold text-gray-800 mb-3 flex items-center gap-2">
                <i class="fas fa-truck text-orange-500"></i>
                Tipos de Serviço
              </h4>
              <div class="space-y-2">
                <div class="bg-blue-50 p-3 rounded-lg border border-blue-200">
                  <p class="font-medium text-blue-800">🛵 Delivery</p>
                  <p class="text-sm text-blue-600">Abrangência: JEREISSATI 2, JEREISSATI 3</p>
                </div>
                <div class="bg-green-50 p-3 rounded-lg border border-green-200">
                  <p class="font-medium text-green-800">🏪 Retirada no Local</p>
                </div>
              </div>
            </div>

            <!-- Horário de Funcionamento -->
            <div class="mb-6">
              <h4 class="font-semibold text-gray-800 mb-3 flex items-center gap-2">
                <i class="fas fa-clock text-orange-500"></i>
                Horário de Funcionamento
              </h4>
              <div class="space-y-2 text-sm">
                <div class="flex justify-between p-2 bg-red-50 rounded border border-red-200">
                  <span class="font-medium">Domingo</span>
                  <span class="text-red-600 font-semibold">Fechado</span>
                </div>
                <div class="flex justify-between p-2 bg-gray-50 rounded">
                  <span class="font-medium">Segunda-feira</span>
                  <span>06:30-10:30 • 14:00-18:00</span>
                </div>
                <div class="flex justify-between p-2 bg-gray-50 rounded">
                  <span class="font-medium">Terça-feira</span>
                  <span>06:30-10:30 • 14:00-18:00</span>
                </div>
                <div class="flex justify-between p-2 bg-gray-50 rounded">
                  <span class="font-medium">Quarta-feira</span>
                  <span>06:30-10:30 • 14:00-18:00</span>
                </div>
                <div class="flex justify-between p-2 bg-gray-50 rounded">
                  <span class="font-medium">Quinta-feira</span>
                  <span>06:30-10:30 • 14:00-18:00</span>
                </div>
                <div class="flex justify-between p-2 bg-gray-50 rounded">
                  <span class="font-medium">Sexta-feira</span>
                  <span>06:30-10:30 • 14:00-18:00</span>
                </div>
                <div class="flex justify-between p-2 bg-gray-50 rounded">
                  <span class="font-medium">Sábado</span>
                  <span>06:30-10:30</span>
                </div>
              </div>
            </div>

            <!-- Especialidades -->
            <div class="mb-4">
              <h4 class="font-semibold text-gray-800 mb-3 flex items-center gap-2">
                <i class="fas fa-utensils text-orange-500"></i>
                Nossas Especialidades
              </h4>
              <div class="grid grid-cols-2 gap-2 text-sm">
                <div class="bg-orange-50 p-2 rounded text-center border border-orange-200">
                  <span class="text-orange-700 font-medium">🥖 Pão na Chapa</span>
