  <!-- Caldo -->
  <section id="caldo" class="py-10 section-bg">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center mb-6">
        <span class="text-2xl mr-3">🍲</span>
        <h3 class="text-2xl font-bold">Caldo</h3>
      </div>
      <div class="grid md:grid-cols-2 gap-4">
        <div class="menu-item p-4 card-hover">
          <div class="flex justify-between items-center">
            <div>
              <h4 class="font-semibold">Caldo no Copo Pequeno</h4>
            </div>
            <div class="flex items-center gap-3">
              <span class="font-bold text-lg">R$ 6,00</span>
              <button class="w-10 h-10 orange-gradient text-white rounded-full orange-hover" onclick="adicionarAoCarrinho('Caldo no Copo Pequeno',6.00)">
                <i class="fas fa-plus"></i>
              </button>
            </div>
          </div>
        </div>
        <div class="menu-item p-4 card-hover">
          <div class="flex justify-between items-center">
            <div>
              <h4 class="font-semibold">Caldo no Copo Grande</h4>
            </div>
            <div class="flex items-center gap-3">
              <span class="font-bold text-lg">R$ 8,00</span>
              <button class="w-10 h-10 orange-gradient text-white rounded-full orange-hover" onclick="adicionarAoCarrinho('Caldo no Copo Grande',8.00)">
                <i class="fas fa-plus"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

