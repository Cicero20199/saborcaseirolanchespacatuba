        </div>
      `;
      
      document.body.appendChild(overlay);
    }

    function fecharInformacoes() {
      const overlay = document.querySelector('.fixed.inset-0.bg-black.bg-opacity-50');
      if (overlay) {
        document.body.removeChild(overlay);
      }
    }

    function mostrarNotificacao(mensagem) {
      const notificacao = document.createElement('div');
      notificacao.className = 'fixed top-20 right-4 bg-green-500 text-white px-4 py-2 rounded-lg shadow-lg z-50 transform translate-x-full transition-transform duration-300';
      notificacao.innerHTML = `
        <div class="flex items-center gap-2">
          <i class="fas fa-check-circle"></i>
          <span>${mensagem}</span>
        </div>
      `;
      
      document.body.appendChild(notificacao);
      
      setTimeout(() => {
        notificacao.classList.remove('translate-x-full');
      }, 100);
      
      setTimeout(() => {
        notificacao.classList.add('translate-x-full');
        setTimeout(() => {
          document.body.removeChild(notificacao);
        }, 300);
      }, 3000);
    }

    function verificarStatusFuncionamento() {
      const agora = new Date();
      const diaSemana = agora.getDay(); // 0 = Domingo, 1 = Segunda, etc.
      const horaAtual = agora.getHours();
      const minutoAtual = agora.getMinutes();
      const horaMinutoAtual = horaAtual * 60 + minutoAtual; // Converter para minutos
      
      const statusIndicator = document.getElementById('status-indicator');
      const statusDot = document.getElementById('status-dot');
      const statusText = document.getElementById('status-text');
      
      let aberto = false;
      
      // Horários de funcionamento (em minutos desde 00:00)
      const horarios = {
        0: [], // Domingo - Fechado
        1: [[390, 630], [840, 1080]], // Segunda: 06:30-10:30, 14:00-18:00
        2: [[390, 630], [840, 1080]], // Terça: 06:30-10:30, 14:00-18:00
        3: [[390, 630], [840, 1080]], // Quarta: 06:30-10:30, 14:00-18:00
        4: [[390, 630], [840, 1080]], // Quinta: 06:30-10:30, 14:00-18:00
        5: [[390, 630], [840, 1080]], // Sexta: 06:30-10:30, 14:00-18:00
        6: [[390, 630]] // Sábado: 06:30-10:30
      };
      
      const horariosHoje = horarios[diaSemana];
      
      // Verificar se está dentro de algum horário de funcionamento
      for (const [inicio, fim] of horariosHoje) {
        if (horaMinutoAtual >= inicio && horaMinutoAtual <= fim) {
          aberto = true;
          break;
        }
      }
      
      if (aberto) {
        statusIndicator.className = 'flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800';
        statusDot.className = 'w-2 h-2 rounded-full bg-green-500';
        statusText.textContent = 'Aberto';
      } else {
        statusIndicator.className = 'flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800';
        statusDot.className = 'w-2 h-2 rounded-full bg-red-500';
        statusText.textContent = 'Fechado';
      }
    }

    function voltarAoTopo() {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    }

    function toggleScrollToTopButton() {
      const scrollToTopBtn = document.getElementById('scroll-to-top');
      if (window.pageYOffset > 300) {
        scrollToTopBtn.classList.add('show');
      } else {
        scrollToTopBtn.classList.remove('show');
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      atualizarCarrinho();
      verificarStatusFuncionamento();
      
      // Atualizar status a cada minuto
      setInterval(verificarStatusFuncionamento, 60000);
      
      // Controlar visibilidade do botão de voltar ao topo
      window.addEventListener('scroll', toggleScrollToTopButton);
      toggleScrollToTopButton(); // Verificar posição inicial
    });
  </script>

