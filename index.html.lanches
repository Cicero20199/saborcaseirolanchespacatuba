<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Sabor Caseiro Lanches - Cardápio Digital</title>
  
  <!-- Meta tags para redes sociais -->
  <meta property="og:title" content="Sabor Caseiro Lanches - Cardápio Digital"/>
  <meta property="og:description" content="Deliciosos lanches caseiros! Cuscuz, Tapioca, Pão na Chapa, Pastéis e muito mais. Delivery no Jereissati II e III."/>
  <meta property="og:image" content="https://i.ibb.co/XxdNVVy5/Av-Marginal-Nordeste-304-JEREISSATI-3-Pacatuba-CE-. -0000.png"/>
  <meta property="og:url" content=""/>
  <meta property="og:type" content="website"/>
  
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content="Sabor Caseiro Lanches - Cardápio Digital"/>
  <meta name="twitter:description" content="Deliciosos lanches caseiros! Cuscuz, Tapioca, Pão na Chapa, Pastéis e muito mais. Delivery no Jereissati II e III."/>
  <meta name="twitter:image" content="https://i.ibb.co/XxdNVVy5/Av-Marginal-Nordeste-304-JEREISSATI-3-Pacatuba-CE-. -0000.png"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    .card-hover{transition:transform .3s, box-shadow .3s}
    .card-hover:hover{transform:translateY(-2px); box-shadow:0 8px 25px -5px rgba(0,0,0,.12)}
    .smooth-scroll{scroll-behavior:smooth}
    .gradient-text{background:linear-gradient(135deg,#FF6B35 0%,#F7931E 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .orange-gradient{background:linear-gradient(135deg,#FF6B35 0%,#F7931E 100%)}
    .orange-hover:hover{background:linear-gradient(135deg,#FF5722 0%,#FF8F00 100%)}
    .category-card{background:white;border:2px solid #FFF3E0}
    .menu-item{background:white;border:1px solid #FFE0B2;border-radius:14px}
    .menu-item:hover{border-color:#FF6B35;box-shadow:0 4px 12px rgba(255,107,53,.15)}
    .section-bg{background:#FFF8F1}
    .glow{box-shadow:0 14px 38px rgba(255,107,53,.55)}
    .modal{background:rgba(0,0,0,.5)}
    .badge{display:inline-flex;align-items:center;gap:.35rem;background:linear-gradient(135deg,#FF6B35 0%,#F7931E 100%);color:#fff;font-weight:800;padding:.2rem .55rem;border-radius:999px;font-size:.7rem;letter-spacing:.3px}
    .banner-glow{transition: transform .3s, box-shadow .3s, filter .3s; box-shadow: 0 8px 24px -10px rgba(0,0,0,.12);}
    .banner-glow:hover{transform: translateY(-1px) scale(1.01); box-shadow: 0 22px 44px -12px rgba(255,107,53,.35); filter: saturate(1.05);}
    .carrinho-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.5);z-index:1000;display:none}
    .carrinho-modal{position:fixed;top:0;right:-100%;width:100%;max-width:500px;height:100%;background:white;z-index:1001;transition:right .3s ease;overflow-y:auto}
    .carrinho-modal.open{right:0}
    .cart-counter{position:absolute;top:-8px;right:-8px;background:#FF6B35;color:white;border-radius:50%;width:20px;height:20px;font-size:12px;display:flex;align-items:center;justify-content:center;font-weight:bold}
    .scroll-to-top{position:fixed;bottom:20px;right:20px;width:50px;height:50px;background:linear-gradient(135deg,#FF6B35 0%,#F7931E 100%);color:white;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4px 12px rgba(255,107,53,.3);transition:all .3s ease;z-index:40;opacity:0;visibility:hidden;transform:translateY(20px)}
    .scroll-to-top.show{opacity:1;visibility:visible;transform:translateY(0)}
    .scroll-to-top:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(255,107,53,.4);background:linear-gradient(135deg,#FF5722 0%,#FF8F00 100%)}
  </style>
</head>
<body class="smooth-scroll bg-white text-gray-800 font-sans">

  <!-- Header -->
  <header class="bg-white shadow-sm fixed w-full top-0 z-40 border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <h1 class="text-lg font-semibold">Sabor Caseiro Lanches</h1>
        <div id="status-indicator" class="flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold">
          <div id="status-dot" class="w-2 h-2 rounded-full"></div>
          <span id="status-text">Verificando...</span>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="mostrarInformacoes()" class="p-2 text-gray-600 hover:text-orange-500" title="Informações do estabelecimento">
          <i class="fas fa-info-circle text-xl"></i>
        </button>
        <button onclick="abrirCarrinho()" class="relative p-2 text-gray-600 hover:text-orange-500">
          <i class="fas fa-shopping-cart text-xl"></i>
          <span id="cart-counter" class="cart-counter hidden">0</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Hero com Banner -->
  <section class="pt-16 pb-6 bg-white">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <a href="https://ibb.co/7J9GHw4D" target="_blank" rel="noopener noreferrer" class="group block">
        <img
          src="https://i.ibb.co/VWKvd7mG/Sabor-. -0000.png"
          alt="Banner Sabor Caseiro - Promo"
          onerror="this.src=''; this.alt='Imagem não pôde carregar'; this.style.display='none';"
          class="w-full mx-auto rounded-2xl border-2 border-orange-300 banner-glow"
          style="max-width: 100%; height: auto;"
        >
      </a>
      <h2 class="text-3xl md:text-4xl font-bold mt-6 mb-2">Cardápio Digital</h2>
      <p class="text-gray-600">Faça seu pedido e envie pelo WhatsApp</p>
    </div>
  </section>

  <!-- Categorias -->
  <section class="pb-8 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
        <div class="category-card rounded-lg p-3 text-center card-hover cursor-pointer relative overflow-hidden" onclick="document.getElementById('caldo').scrollIntoView({behavior:'smooth'})">
          <div class="w-12 h-12 mx-auto mb-2 rounded-full overflow-hidden bg-orange-100">
            <img src="https://images.unsplash.com/photo-1547592166-23ac45744acd?w=100&h=100&fit=crop&crop=center" alt="Caldo" class="w-full h-full object-cover" onerror="this.src=''; this.style.display='none'; this.nextElementSibling.style.display='block';">
            <div class="w-full h-full flex items-center justify-center text-2xl" style="display: none;">🍲</div>
          </div>
          <div class="text-xs font-semibold">Caldo</div>
        </div>
        <div class="category-card rounded-lg p-3 text-center card-hover cursor-pointer relative overflow-hidden" onclick="document.getElementById('cuscuz').scrollIntoView({behavior:'smooth'})">
          <div class="w-12 h-12 mx-auto mb-2 rounded-full overflow-hidden bg-orange-100">
            <img src="https://i.ibb.co/MxdMR8qQ/images-15.jpg" alt="Cuscuz" class="w-full h-full object-cover" onerror="this.src=''; this.style.display='none'; this.nextElementSibling.style.display='block';">
            <div class="w-full h-full flex items-center justify-center text-2xl" style="display: none;">🌽</div>
          </div>
          <div class="text-xs font-semibold">Cuscuz</div>
        </div>
        <div class="category-card rounded-lg p-3 text-center card-hover cursor-pointer relative overflow-hidden" onclick="document.getElementById('tapioca-recheada').scrollIntoView({behavior:'smooth'})">
          <div class="w-12 h-12 mx-auto mb-2 rounded-full overflow-hidden bg-orange-100">
            <img src="https://i.ibb.co/zH2dXqx6/maxresdefault.jpg" alt="Tapioca" class="w-full h-full object-cover" onerror="this.src=''; this.style.display='none'; this.nextElementSibling.style.display='block';">
            <div class="w-full h-full flex items-center justify-center text-2xl" style="display: none;">🫓</div>
          </div>
          <div class="text-xs font-semibold">Tapioca Recheada</div>
        </div>
        <div class="category-card rounded-lg p-3 text-center card-hover cursor-pointer relative overflow-hidden" onclick="document.getElementById('tapioca-redonda').scrollIntoView({behavior:'smooth'})">
          <div class="w-12 h-12 mx-auto mb-2 rounded-full overflow-hidden bg-orange-100">
            <img src="https://i.ibb.co/Kz7hk3Td/images-14.jpg" alt="Tapioca Redonda" class="w-full h-full object-cover" onerror="this.src=''; this.style.display='none'; this.nextElementSibling.style.display='block';">
            <div class="w-full h-full flex items-center justify-center text-2xl" style="display: none;">⚪</div>
          </div>
          <div class="text-xs font-semibold">Tapioca Redonda</div>
        </div>
        <div class="category-card rounded-lg p-3 text-center card-hover cursor-pointer relative overflow-hidden" onclick="document.getElementById('pasteis').scrollIntoView({behavior:'smooth'})">
