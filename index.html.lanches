          <div class="w-12 h-12 mx-auto mb-2 rounded-full overflow-hidden bg-orange-100">
            <img src="https://i.ibb.co/qM1LVCK3/images-18.jpg" alt="Bebidas" class="w-full h-full object-cover" onerror="this.src=''; this.style.display='none'; this.nextElementSibling.style.display='block';">
            <div class="w-full h-full flex items-center justify-center text-2xl" style="display: none;">🥤</div>
