        <div class="category-card rounded-lg p-3 text-center card-hover cursor-pointer relative overflow-hidden" onclick="document.getElementById('refri-latinha').scrollIntoView({behavior:'smooth'})">
          <div class="w-12 h-12 mx-auto mb-2 rounded-full overflow-hidden bg-orange-100">
            <img src="https://images.unsplash.com/photo-1629203851122-3726ecdf080e?w=100&h=100&fit=crop&crop=center" alt="Refrigerante" class="w-full h-full object-cover" onerror="this.src=''; this.style.display='none'; this.nextElementSibling.style.display='block';">
            <div class="w-full h-full flex items-center justify-center text-2xl" style="display: none;">🥤</div>
